<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_saint_of_the_day"
        android:textAllCaps="true"
        android:textColor="#D5CFC8"
        android:textSize="10sp"
        android:letterSpacing="0.08"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_default_title"
        android:textColor="#FFF8F2"
        android:textSize="17sp"
        android:textStyle="bold"
        android:fontFamily="serif" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#7A4A43" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/label_mizbak_psalm"
        android:textAllCaps="true"
        android:textColor="#D5CFC8"
        android:textSize="10sp"
        android:letterSpacing="0.08"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/widget_snksar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#FFF8F2"
        android:textSize="14sp"
        android:fontFamily="serif" />

    <TextView
        android:id="@+id/widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#D5CFC8"
        android:textSize="11sp" />
</LinearLayout>
